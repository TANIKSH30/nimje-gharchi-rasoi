# ==============================================================================
# NIMJE GHARCHI RASOI - ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# Copy this file to .env.local and populate with your project credentials.
# NEVER commit .env.local or production secrets to source control.
# ==============================================================================

# Supabase Public Configuration (Obtain from Supabase Dashboard > Settings > API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here

# Business UPI Payment Configuration (Client fallback defaults)
VITE_UPI_ID=tanikshnimje@okaxis
VITE_PAYEE_NAME=Taniksh Nimje
VITE_BUSINESS_NAME=Nimje Gharchi Rasoi

# Application Production URL
VITE_APP_URL=https://your-domain.vercel.app

# ==============================================================================
# SERVER-SIDE ONLY SECRETS (Configure in Supabase Edge Functions Secrets / Vercel Serverless)
# CRITICAL: DO NOT PREFIX WITH VITE_ AND NEVER EXPOSE TO CLIENT BUNDLES!
# ==============================================================================

# Supabase Service Role Key (Database Admin operations only)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here

# Admin Notification Contacts
ADMIN_EMAIL=admin@example.com
ADMIN_PHONE=919876543210

# Email Delivery Provider (Resend API)
RESEND_API_KEY=your_resend_api_key_here

# SMS Delivery Provider (Fast2SMS India)
FAST2SMS_API_KEY=your_fast2sms_api_key_here

# Alternative SMS Provider (Twilio)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890
